{
    "name": "ai-usage-monitor-desktop",
    "productName": "AI Usage Monitor",
    "private": true,
    "type": "module",
    "version": "0.1.0",
    "description": "App de bandeja (Windows/Linux) que monitora consumo/cota de assinaturas de IA.",
    "main": "src/main/main.js",
    "author": "Tiago Meconi",
    "license": "MIT",
    "scripts": {
        "sync-shared": "node scripts/sync-shared.mjs",
        "screenshots": "npm run sync-shared && electron scripts/screenshots.mjs",
        "prestart": "npm run sync-shared",
        "start": "electron .",
        "pretest": "npm run sync-shared",
        "test": "node --test tests/*.test.js",
        "dist:win": "npm run sync-shared && electron-builder --win nsis",
        "dist:linux": "npm run sync-shared && electron-builder --linux AppImage rpm"
    },
    "devDependencies": {
        "electron": "^45.1.0",
        "electron-builder": "^26.18.0"
    },
    "build": {
        "appId": "io.prohound.aiusagemonitor",
        "productName": "AI Usage Monitor",
        "files": ["src/**", "assets/**", "package.json"],
        "icon": "assets/icons/logo.png",
        "win": { "target": ["nsis"] },
        "nsis": { "oneClick": true, "perMachine": false },
        "linux": { "target": ["AppImage", "rpm"], "category": "Utility" }
    }
}
